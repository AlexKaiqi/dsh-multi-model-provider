{
  "name": "dsh-multi-model-provider",
  "description": "Agent-assisted language and task-model registration for DeepSeek Harness",
  "version": "0.1.0-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-multi-model-provider.git"
  },
  "homepage": "https://github.com/AlexKaiqi/dsh-multi-model-provider#readme",
  "bugs": {
    "url": "https://github.com/AlexKaiqi/dsh-multi-model-provider/issues"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "clean": "tsc -b --clean && rm -rf lib",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "让 Agent 安全注册语言、图片、音频、视频等模型，并区分注册状态与运行时可用性。",
        "en": "Lets agents safely register language, image, audio, video, and other models while separating registration from runtime availability."
      },
      "tags": [
        "model",
        "provider",
        "configuration",
        "multimodal"
      ],
      "dependencies": [
        "@deepseek-ai/dsh-llm-pi-ai",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-credentials",
        "@deepseek-ai/dsh-agent-default-model"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
