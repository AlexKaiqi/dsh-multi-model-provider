{
  "name": "dsh-multi-model-provider",
  "description": "Register models, assist with portraits, and select the Agent model from a secret-free catalog for DeepSeek Harness.",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "model",
    "provider",
    "multimodal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-multi-model-provider.git"
  },
  "homepage": "https://github.com/AlexKaiqi/dsh-multi-model-provider#readme",
  "bugs": {
    "url": "https://github.com/AlexKaiqi/dsh-multi-model-provider/issues"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "clean": "tsc -b --clean && rm -rf lib",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "三件事：登记模型、辅助构建画像、从目录里选 Agent 主模型。peer 插件 inject modelCatalog 后用 snapshot() 读取全部已登记模型；selectAgentModel() 只选 live 语言模型。Settings 负责登记、画像和测速；默认安装不可调用。",
        "en": "Three capabilities: register models, assist with portraits, and select the Agent model from that catalog. Inject modelCatalog, call snapshot() to read every registered model, then selectAgentModel() for a live language model. Settings owns registration, portraits, and speed tests; a default install is not callable."
      },
      "tags": [
        "model",
        "provider",
        "configuration",
        "multimodal"
      ],
      "dependencies": [
        "@deepseek-ai/dsh-llm-pi-ai",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-credentials",
        "@deepseek-ai/dsh-agent-default-model",
        "@deepseek-ai/dsh-session",
        "@deepseek-ai/dsh-tools"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
